{
  "name": "opencode-gpt-live",
  "version": "0.3.0",
  "description": "Talk to OpenCode out loud: real-time GPT-Live voice calls on your ChatGPT subscription",
  "keywords": [
    "chatgpt",
    "gpt-live",
    "opencode",
    "opencode-plugin",
    "realtime",
    "speech",
    "voice",
    "voice-assistant",
    "webrtc"
  ],
  "homepage": "https://github.com/malhashemi/opencode-gpt-live#readme",
  "bugs": "https://github.com/malhashemi/opencode-gpt-live/issues",
  "license": "MIT",
  "author": "M. Adel Alhashemi (https://github.com/malhashemi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malhashemi/opencode-gpt-live.git"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "dist/gui-experimental.cjs",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/shared/rpc.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.gui.json",
    "test": "bun test",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "e2e": "bun scripts/e2e-call.ts",
    "build:gui": "vite build",
    "dev:gui": "vite build --watch"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@livekit/wakeword": "2.1.3",
    "@opencode/client": "2.3.0",
    "@opencode/theme": "2.0.14",
    "@opentui/core": "0.5.12",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "onnxruntime-web": "1.31.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "solid-js": "1.9.17",
    "typescript": "^5.9.0",
    "vite": "^7",
    "vite-plugin-solid": "^2.11.17"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10"
  },
  "engines": {
    "opencode": ">=2.0.20"
  }
}
